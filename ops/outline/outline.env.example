SECRET_KEY=<generate: openssl rand -hex 32>
UTILS_SECRET=<generate: openssl rand -hex 32>
OUTLINE_API_TOKEN=<from Outline UI: Settings → API tokens>

POSTGRES_PASSWORD=<strong-random-password>
DATABASE_URL=postgres://outline:<DB_PASSWORD>@postgres:5432/outline
DATABASE_URL_TEST=postgres://outline:<DB_PASSWORD>@postgres:5432/outline-test
PGSSLMODE=disable
RATE_LIMITER_ENABLED=true
REDIS_URL=redis://redis:6379

OUTLINE_URL=https://wiki.secretshop.ua
PORT=3000

# MinIO Storage
FILE_STORAGE=s3
AWS_ACCESS_KEY_ID=<minio-root-user>
AWS_SECRET_ACCESS_KEY=<minio-root-password>
AWS_REGION=us-east-1
AWS_S3_UPLOAD_BUCKET_URL=http://minio:9000
AWS_S3_UPLOAD_BUCKET_NAME=outline
AWS_S3_FORCE_PATH_STYLE=true

# Authentication (Authelia OIDC)
OIDC_CLIENT_ID=outline
OIDC_CLIENT_SECRET=<from Authelia OIDC client config>
OIDC_AUTH_URI=https://auth.secretshop.ua/api/oidc/authorization
OIDC_TOKEN_URI=https://auth.secretshop.ua/api/oidc/token
OIDC_USERINFO_URI=https://auth.secretshop.ua/api/oidc/userinfo
OIDC_JWKS_URI=https://auth.secretshop.ua/api/oidc/jwks
OIDC_DISPLAY_NAME="Secretshop SSO"
OIDC_SCOPES="openid profile email"

# Allow Outline to be accessed over HTTP internally via Caddy/Proxy
FORCE_HTTPS=false
